@{ViewData["Title"]="Reports";}<h1 class="page-title">CRM Reports</h1><p class="text-muted">Summary reports scoped to your authorized records.</p><div class="row g-3">@foreach(var x in new[]{("Customers",ViewBag.Customers),("Leads",ViewBag.Leads),("Converted Leads",ViewBag.Converted),("Follow-ups",ViewBag.Followups),("Overdue Follow-ups",ViewBag.Overdue),("Won Opportunities",ViewBag.Won)}){<div class="col-md-4 col-sm-6"><div class="card p-3"><div class="muted-label">@x.Item1</div><div class="metric">@x.Item2</div></div></div>}<div class="col-md-4"><div class="card p-3"><div class="muted-label">Open Pipeline Value</div><div class="metric">@(((decimal)ViewBag.Pipeline).ToString("C0",System.Globalization.CultureInfo.GetCultureInfo("en-IN")))</div></div></div></div><div class="alert alert-info mt-4">Use the Dashboard for stage-wise charts. Admin users can review detailed audit events from Audit Log.</div>
