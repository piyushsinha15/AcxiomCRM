@{ViewData["Title"]="Dashboard";}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="page-title">Sales Dashboard</h1><p class="text-muted mb-0">Overview of your authorized CRM data.</p></div><span class="badge text-bg-primary">@((User.IsInRole("Admin")?"Admin":User.IsInRole("Manager")?"Manager":"Sales Executive"))</span></div>
<div class="row g-3 mb-4">@foreach(var item in new[]{("Customers",ViewBag.Customers),("Leads",ViewBag.Leads),("Open Leads",ViewBag.OpenLeads),("Opportunities",ViewBag.Opportunities),("Open Opportunities",ViewBag.OpenOpportunities),("Won",ViewBag.Won),("Lost",ViewBag.Lost)}){<div class="col-6 col-md-3"><div class="card p-3 h-100"><div class="muted-label">@item.Item1</div><div class="metric">@item.Item2</div></div></div>}<div class="col-12 col-md-3"><div class="card p-3 h-100"><div class="muted-label">Open Pipeline</div><div class="metric">@(((decimal)ViewBag.Pipeline).ToString("C0",System.Globalization.CultureInfo.GetCultureInfo("en-IN")))</div></div></div></div>
<div class="row g-3"><div class="col-md-6"><div class="card p-3"><h5>Lead Status</h5><canvas id="leadChart" height="220"></canvas></div></div><div class="col-md-6"><div class="card p-3"><h5>Opportunity Pipeline</h5><canvas id="oppChart" height="220"></canvas></div></div></div>
@section Scripts {<script>new Chart(document.getElementById('leadChart'),{type:'doughnut',data:{labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize((string[])ViewBag.LeadLabels)),datasets:[{data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize((int[])ViewBag.LeadValues))}]},options:{responsive:true}});new Chart(document.getElementById('oppChart'),{type:'bar',data:{labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize((string[])ViewBag.StageLabels)),datasets:[{label:'Opportunities',data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize((int[])ViewBag.StageValues))}]},options:{responsive:true,scales:{y:{beginAtZero:true,ticks:{precision:0}}}}});</script>}
